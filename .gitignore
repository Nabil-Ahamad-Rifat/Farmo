# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo: node_modules/build outputs can appear at the root or under
# apps/*/packages/* — patterns below are intentionally not anchored to `/`
# so they match at any depth.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# turborepo
.turbo

# local agent worktrees
.kilo/

# testing
coverage/

# next.js
.next/
out/

# production
build/

# expo / react native (apps/mobile)
.expo/
dist/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite (legacy — project now uses MongoDB Atlas)
*.db
*.db-journal

# never commit captured cookies/tokens from manual testing
*cookies*.txt

.vercel
.env*
