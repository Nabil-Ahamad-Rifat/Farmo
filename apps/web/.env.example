# Copy to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string.
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/farm_management?retryWrites=true&w=majority"

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Required in every environment — the app refuses to start without it.
JWT_SECRET=""

# Public base URL of the deployed app (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Google OAuth, web redirect flow ("Continue with Google" is disabled if these are blank).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Google Sign-In, native mobile flow (apps/mobile) — separate OAuth
# client IDs registered per-platform in Google Cloud Console. At least one of
# these (or GOOGLE_CLIENT_ID above) must be set for /api/auth/google/mobile
# to accept sign-ins.
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""

# Optional: gates the mobile app's forced-update screen (apps/mobile checks
# /api/meta/version at launch). All default to "1.0.0" if unset.
MOBILE_MIN_SUPPORTED_VERSION=""
MOBILE_LATEST_VERSION=""
MOBILE_FORCE_UPDATE_BELOW=""

# Email (password-reset links). Used in this order; with neither set, the
# development machine shows the link on screen and production sends nothing.
#
# 1) Gmail or any SMTP server — free, no domain needed. For Gmail, turn on
#    2-step verification and create an "app password" (not your normal password).
SMTP_USER=""
SMTP_PASS=""
# Optional; defaults are Gmail's.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_FROM=""
#
# 2) Resend — needs a domain verified with Resend.
RESEND_API_KEY=""
# Must be a sender address on a domain verified with Resend.
RESEND_FROM_EMAIL="Farm Manager <no-reply@yourdomain.com>"

# Secret for the daily cleanup job (/api/cron/cleanup). Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>". At least 16 random characters; the job
# refuses to run without it.
CRON_SECRET=""

# Set to "1" only when Cloudflare proxies the site: rate limits then use the
# visitor's real IP from cf-connecting-ip. Leave blank otherwise (the header
# could be forged when Cloudflare isn't in front).
TRUST_CLOUDFLARE=""
