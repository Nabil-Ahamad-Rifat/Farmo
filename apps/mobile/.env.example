# Copy to .env. Expo inlines EXPO_PUBLIC_* vars into the JS bundle at build
# time — never put a secret here, only the public API base URL.
#
# - iOS Simulator / web: http://localhost:3000 works.
# - Android Emulator: use http://10.0.2.2:3000 instead (localhost on the
#   emulator refers to the emulator itself, not your dev machine).
# - Physical device (Expo Go / dev client): use your dev machine's LAN IP,
#   e.g. http://192.168.1.23:3000 — `next dev` prints this under "Network".
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Optional: native Google Sign-In. Leave all blank to hide the "Continue
# with Google" button entirely. These are the SAME OAuth client IDs
# registered in Google Cloud Console as the backend's GOOGLE_IOS_CLIENT_ID /
# GOOGLE_ANDROID_CLIENT_ID / GOOGLE_CLIENT_ID (apps/web/.env.example) — the
# backend verifies the ID token's audience against those, so the values must
# match on both sides. Requires a custom dev client / EAS build to test:
# Google's redirect restrictions mean this flow does not work in Expo Go.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
